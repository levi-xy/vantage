# Copy to .env and adjust. Never commit .env or anything in secrets/.
#
# The easiest way to set up: run ./setup.sh. It creates whatever is missing of
# secrets/master.key, secrets/prometheus_token and this .env, sets safe permissions,
# starts the stack and prints the address. ./setup.sh --no-start only makes the files.
#
# By hand instead (secrets are files, not variables):
#   mkdir -p -m 700 secrets   # only you may enter it; the containers still read the files
#   openssl rand -base64 32 > secrets/master.key
#   openssl rand -hex 32    > secrets/prometheus_token
#   chmod 644 secrets/*       # containers run as other non-root users (or, as root:
#                             # chown 10001 + chmod 400 master.key,
#                             # chown 10001:65534 + chmod 440 prometheus_token)
# master.key must be 32 random bytes, base64-encoded (as generated above); the
# backend refuses to start without a valid key.
# Back up master.key separately: without it, stored credentials are unreadable.
#
# HTTPS certificate: deploy/certs/tls.crt (PEM, full chain) and deploy/certs/tls.key
# (PEM, unencrypted). Put your own there, or let ./setup.sh generate a self-signed pair
# for the names in VANTAGE_TLS_NAMES below (it never replaces existing files). The key
# must be readable by the frontend container user (uid 101) but no other host user:
# setup.sh sets that up (mkdir -m 700 certs; as root chown 101 + chmod 400 tls.key).

# Address and port the dashboard listens on. 127.0.0.1 = this machine only;
# set to the host's LAN/VPN address to reach it from admin machines.
# On 127.0.0.1, every client coming through the host's loopback (an SSH tunnel,
# or an HTTPS reverse proxy on the host) looks like one address to Vantage (the
# compose network's gateway, 192.168.255.241), so they share one failed-login
# budget (see docs/SECURITY.md).
VANTAGE_BIND_ADDRESS=127.0.0.1
# The dashboard is served over HTTPS on this port: https://<address>:8443. Plain
# HTTP to the same port is redirected to HTTPS. (Older .env files name it
# VANTAGE_HTTP_PORT; that still works when this one isn't set.)
VANTAGE_HTTPS_PORT=8443

# Extra host names and IP addresses the generated self-signed certificate is valid
# for, comma-separated (e.g. vantage.home.example,192.0.2.10). It always covers
# localhost, 127.0.0.1, this server's host name and a specific VANTAGE_BIND_ADDRESS.
# Only read by ./setup.sh when it creates the certificate: to regenerate, delete
# certs/tls.crt and certs/tls.key and run ./setup.sh again.
VANTAGE_TLS_NAMES=

# Strict-Transport-Security. Only set to true once browsers trust the certificate
# (your own from a trusted CA): with a self-signed one, HSTS stops browsers from
# letting you past the certificate warning. Browsers remember it for a year.
VANTAGE_HSTS=false

# SQLite by default. Postgres example:
# VANTAGE_DATABASE_URL=postgresql+psycopg://vantage:example-password@db:5432/vantage
VANTAGE_DATABASE_URL=sqlite:////data/vantage.db

# Metric history is kept for this long or until it uses this much disk, whichever
# comes first. At the size cap Prometheus deletes the oldest data first. Units: B, KB,
# MB, GB, TB (powers of 1024).
VANTAGE_PROMETHEUS_RETENTION=30d
# VANTAGE_PROMETHEUS_RETENTION_SIZE=10GB

# Login sessions end this many hours after login, or after this many minutes
# without any request (an open dashboard keeps its session active).
VANTAGE_SESSION_MAX_HOURS=12
VANTAGE_SESSION_IDLE_MINUTES=120

# HTTPS is on by default. Explicit opt-out: false serves plain HTTP on the same
# port (a LAN without TLS, or your own TLS proxy in front). Anyone on the network
# path can then read logins and session cookies. Over plain HTTP from another
# machine you also need VANTAGE_COOKIE_SECURE=false, or the browser drops the
# session cookie and login doesn't stick.
VANTAGE_HTTPS=true

# Session cookies are Secure (sent over HTTPS only), which works out of the box
# since the dashboard is served over HTTPS. Only set this to false together with
# VANTAGE_HTTPS=false (or behind your own plain-HTTP proxy); that lets anyone on
# the network path read the session cookie.
VANTAGE_COOKIE_SECURE=true

# Reverse proxies allowed to tell the backend the real client address (in the
# X-Real-IP header), as a comma-separated CIDR list. The login rate limit counts
# failures per client address, so this must name exactly the proxy in front of the
# backend. docker-compose.yml already sets it to the bundled frontend container's
# fixed address (192.168.255.242/32); leave it unset (an empty value keeps that
# default) unless you change that network (see docker-compose.yml).
# Never list a range that ordinary clients can connect to the backend from.
# VANTAGE_TRUSTED_PROXIES=
